# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Contractor review receipts (local run artifacts)
.claude/receipts/

# Agentic OS local runtime state (sqlite dbs, event log) — per-machine, not source
.claude/agentic-os/state/

# Installer backups
*.aos-backup

# Stale nested clone of this same repo (has its own .git and .env.local).
# Pending deletion; ignored so its credentials can never be committed.
/alumnitracer/
CLAUDE.md.aos-backup
